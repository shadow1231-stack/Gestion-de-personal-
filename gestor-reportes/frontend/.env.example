# Frontend: SOLO variables públicas (§4 cero secretos en el cliente).
# Cualquier valor VITE_* se incrusta en el bundle y es visible por el usuario.
VITE_API_URL=http://localhost:8000/api/v1

# Observabilidad (§7). El DSN de Sentry es público por diseño (no es un secreto).
# Déjalo vacío en desarrollo para desactivar el envío de errores.
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=development
