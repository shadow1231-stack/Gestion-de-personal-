# === Plantilla de variables de entorno (§3 AGENTS.md) ===
# Copia este archivo a `.env` y rellena valores reales.
# NUNCA subas `.env` al control de versiones.

# --- Base de datos ---
POSTGRES_USER=gestor
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gestor_reportes
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://gestor:changeme@db:5432/gestor_reportes

# --- Seguridad / JWT ---
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS (§5) ---
CORS_ORIGINS=http://localhost:5173

# --- Observabilidad (§7) ---
SENTRY_DSN=
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api/v1
# DSN público de Sentry para el navegador (déjalo vacío para desactivar).
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=development
